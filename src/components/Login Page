import React, { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useAuth } from '../contexts/AuthContext';
import Input from '../components/common/Input';
import Button from '../components/common/Button';
import { toast } from 'react-hot-toast';
import logo from '../assets/images/logo.png';

const LoginPage = () => {
  const [credentials, setCredentials] = useState({
    email: '1',
    password: '1'
  });
  const [loading, setLoading] = useState(false);
  const { login } = useAuth();
  const navigate = useNavigate();

  const handleChange = (e) => {
    const { name, value } = e.target;
    setCredentials(prev => ({
      ...prev,
      [name]: value
    }));
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setLoading(true);
    try {
      await login(credentials.email, credentials.password);
      toast.success('เข้าสู่ระบบสำเร็จ');
      navigate('/');
    } catch (err) {
      toast.error('อีเมลหรือรหัสผ่านไม่ถูกต้อง');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen flex items-center justify-center bg-gradient-to-b from-primary-green to-primary-brown p-4">
      <div className="w-full max-w-md bg-white rounded-lg shadow-lg overflow-hidden">
        <div className="bg-primary-green p-6 text-center">
          <img src={logo} alt="E-Rice Smart System" className="h-16 mx-auto mb-4" />
          <h1 className="text-2xl font-bold text-white">E-Rice Smart System</h1>
          <p className="text-white">ระบบจัดการโรงสีข้าวอัจฉริยะ</p>
        </div>
        
        <form onSubmit={handleSubmit} className="p-6 space-y-6">
          <Input
            label="อีเมล"
            name="email"
            type="email"
            value={credentials.email}
            onChange={handleChange}
            required
            placeholder="กรอกอีเมลผู้ใช้งาน"
            icon="envelope"
          />
          
          <Input
            label="รหัสผ่าน"
            name="password"
            type="password"
            value={credentials.password}
            onChange={handleChange}
            required
            placeholder="กรอกรหัสผ่าน"
            icon="lock"
          />
          
          <Button 
            type="submit" 
            className="btn-primary w-full"
            disabled={loading}
          >
            {loading ? 'กำลังเข้าสู่ระบบ...' : 'เข้าสู่ระบบ'}
          </Button>
        </form>
        
        <div className="bg-gray-50 px-6 py-4 text-center">
          <p className="text-gray-600">
            หากมีปัญหาในการเข้าสู่ระบบ กรุณาติดต่อเจ้าหน้าที่
          </p>
        </div>
      </div>
    </div>
  );
};

export default LoginPage;